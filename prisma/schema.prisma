generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
  ADJUST
}

enum TxStatus {
  POSTED
  VOID
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  accounts     Account[]
  transactions Transaction[]
}

model Account {
  id      String  @id @default(uuid())
  userId  String
  name    String
  kind    String
  opening Decimal @default(0) @db.Decimal(14, 2)
  active  Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Category {
  id     String  @id @default(uuid())
  userId String
  name   String
  active Boolean @default(true)

  @@unique([userId, name])
}

model Transaction {
  id               String   @id @default(uuid())
  userId           String
  type             TxType
  amount           Decimal  @db.Decimal(14, 2)
  title            String
  note             String?
  category         String?
  categoryId       String?
  fromAccountId    String?
  toAccountId      String?
  billOccurrenceId String?
  idempotencyKey   String
  status           TxStatus @default(POSTED)
  occurredAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId, occurredAt])
}

model BillOccurrence {
  id         String   @id @default(uuid())
  userId     String
  name       String
  amount     Decimal  @db.Decimal(14, 2)
  dueDate    DateTime
  templateId String?

  @@unique([userId, name, dueDate])
}

model SalaryPayment {
  id          String   @id @default(uuid())
  userId      String
  periodStart DateTime
  expected    Decimal  @db.Decimal(14, 2)
  received    Decimal? @db.Decimal(14, 2)

  @@unique([userId, periodStart])
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  categoryId  String
  amount      Decimal  @db.Decimal(14, 2)
  periodStart DateTime

  @@unique([userId, categoryId, periodStart])
}

model SavingsGoal {
  id        String  @id @default(uuid())
  userId    String
  name      String
  target    Decimal @db.Decimal(14, 2)
  accountId String?

  @@index([userId])
}

// บิลประจำ: ระบบสร้างรายการ BillOccurrence ของแต่ละเดือนให้อัตโนมัติ
model BillTemplate {
  id        String   @id @default(uuid())
  userId    String
  name      String
  amount    Decimal  @db.Decimal(14, 2)
  dayOfMonth Int
  category  String?
  accountId String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ตั้งเงินเดือนอัตโนมัติ: 1 คน 1 การตั้งค่า, startsAt = เริ่มนับรอบถัดไปหลังจากบันทึก
model SalarySetting {
  id        String   @id @default(uuid())
  userId    String   @unique
  amount    Decimal  @db.Decimal(14, 2)
  payDay    Int
  accountId String
  title     String   @default("เงินเดือน")
  active    Boolean  @default(true)
  startsAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
}
