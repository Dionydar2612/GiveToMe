generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
  ADJUST
}

enum TxStatus {
  POSTED
  VOID
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  accounts     Account[]
  transactions Transaction[]
}

model Account {
  id      String  @id @default(uuid())
  userId  String
  name    String
  kind    String
  opening Decimal @default(0) @db.Decimal(14, 2)
  active  Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Category {
  id     String  @id @default(uuid())
  userId String
  name   String
  active Boolean @default(true)

  @@unique([userId, name])
}

model Transaction {
  id               String   @id @default(uuid())
  userId           String
  type             TxType
  amount           Decimal  @db.Decimal(14, 2)
  title            String
  note             String?
  category         String?
  categoryId       String?
  fromAccountId    String?
  toAccountId      String?
  billOccurrenceId String?
  idempotencyKey   String
  status           TxStatus @default(POSTED)
  occurredAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId, occurredAt])
}

model BillOccurrence {
  id      String   @id @default(uuid())
  userId  String
  name    String
  amount  Decimal  @db.Decimal(14, 2)
  dueDate DateTime

  @@unique([userId, name, dueDate])
}

// รายจ่ายประจำเดือน (แม่แบบ) — ติ๊กจ่ายแต่ละเดือนจะสร้างรายการรายจ่ายจริงและตัดยอดบัญชี
model RecurringBill {
  id        String      @id @default(uuid())
  userId    String
  name      String
  amount    Decimal     @db.Decimal(14, 2)
  dueDay    Int         @default(1)
  frequency String      @default("MONTHLY")
  weekday   Int?
  accountId String?
  category  String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  checks    BillCheck[]
  payments  RecurringBillPayment[]

  @@index([userId])
}

// การติ๊กจ่ายของแต่ละเดือน (month = "YYYY-MM")
model BillCheck {
  id            String        @id @default(uuid())
  userId        String
  billId        String
  month         String
  amount        Decimal       @db.Decimal(14, 2)
  accountId     String?
  transactionId String?
  paidAt        DateTime      @default(now())
  bill          RecurringBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, month])
  @@index([userId, month])
}

model SalaryPayment {
  id          String   @id @default(uuid())
  userId      String
  periodStart DateTime
  expected    Decimal  @db.Decimal(14, 2)
  received    Decimal? @db.Decimal(14, 2)

  @@unique([userId, periodStart])
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  categoryId  String
  amount      Decimal  @db.Decimal(14, 2)
  periodStart DateTime

  @@unique([userId, categoryId, periodStart])
}

model SavingsGoal {
  id        String  @id @default(uuid())
  userId    String
  name      String
  target    Decimal @db.Decimal(14, 2)
  accountId String?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
}


// New schedule occurrence ledger. Keeps legacy BillCheck rows untouched.
model RecurringBillPayment {
  id            String        @id @default(uuid())
  userId        String
  billId        String
  dueDate       DateTime      @db.Date
  amount        Decimal       @db.Decimal(14, 2)
  accountId     String
  transactionId String?       @unique
  paidAt        DateTime      @default(now())
  bill          RecurringBill @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([billId, dueDate])
  @@index([userId, dueDate])
}
